{
  "name": "deepseek-harness-vscode",
  "displayName": "DeepSeek Harness",
  "description": "VS Code extension for DeepSeek Harness (ACP) with opencode session history access",
  "version": "0.0.17",
  "publisher": "deepseek-harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/deepseek-harness.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:deepseekHarness.sessions",
    "onView:deepseekHarness.opencodeHistory",
    "onCommand:deepseekHarness.openChatEditor",
    "onCommand:deepseekHarness.refreshOpencode",
    "onCommand:deepseekHarness.openOpencodeSession"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepseekHarness",
          "title": "DeepSeek Harness",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "deepseekHarness": [
        {
          "id": "deepseekHarness.sessions",
          "name": "DSH Sessions",
          "initialSize": 1
        },
        {
          "id": "deepseekHarness.opencodeHistory",
          "name": "opencode History",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "deepseekHarness.openChatEditor",
        "title": "Open DSH Chat in Editor",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "deepseekHarness.refreshOpencode",
        "title": "Refresh opencode History",
        "icon": "$(refresh)"
      },
      {
        "command": "deepseekHarness.refreshSessions",
        "title": "Refresh DSH Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "deepseekHarness.selectDshSession",
        "title": "Switch to DSH Session"
      },
      {
        "command": "deepseekHarness.renameDshSession",
        "title": "Rename DSH Session"
      },
      {
        "command": "deepseekHarness.setupModel",
        "title": "DSH: Setup Model (provider/model)"
      },
      {
        "command": "deepseekHarness.openOpencodeSession",
        "title": "Open opencode Session in Chat"
      },
      {
        "command": "deepseekHarness.openOpencodeFile",
        "title": "Open opencode Transcript (read-only preview)"
      },
      {
        "command": "deepseekHarness.sendOpencodeToDsh",
        "title": "Send opencode Session to DSH"
      },
      {
        "command": "deepseekHarness.newDshSession",
        "title": "New DSH Session"
      },
      {
        "command": "deepseekHarness.openDshChat",
        "title": "Open DSH Chat"
      },
      {
        "command": "deepseekHarness.openSettings",
        "title": "DSH: Open Settings (Harness-style)",
        "icon": "$(gear)"
      },
      {
        "command": "deepseekHarness.installDsh",
        "title": "DSH: Install dsh CLI"
      },
      {
        "command": "deepseekHarness.diagnose",
        "title": "DSH: Diagnose opencode + DSH connections"
      },
      {
        "command": "deepseekHarness.selectWorkspace",
        "title": "DSH: Select Workspace (cwd for new sessions)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepseekHarness.openSettings",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@0"
        },
        {
          "command": "deepseekHarness.openChatEditor",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@1"
        },
        {
          "command": "deepseekHarness.newDshSession",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@2"
        },
        {
          "command": "deepseekHarness.refreshSessions",
          "when": "view == deepseekHarness.sessions",
          "group": "navigation@3"
        },
        {
          "command": "deepseekHarness.refreshOpencode",
          "when": "view == deepseekHarness.opencodeHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deepseekHarness.selectDshSession",
          "when": "view == deepseekHarness.sessions && viewItem == dshSession",
          "group": "inline"
        },
        {
          "command": "deepseekHarness.renameDshSession",
          "when": "view == deepseekHarness.sessions && viewItem == dshSession",
          "group": "inline"
        },
        {
          "command": "deepseekHarness.openOpencodeSession",
          "when": "view == deepseekHarness.opencodeHistory && viewItem == opencodeSession",
          "group": "inline"
        },
        {
          "command": "deepseekHarness.openOpencodeFile",
          "when": "view == deepseekHarness.opencodeHistory && viewItem == opencodeSession",
          "group": "context"
        },
        {
          "command": "deepseekHarness.sendOpencodeToDsh",
          "when": "view == deepseekHarness.opencodeHistory && viewItem == opencodeSession",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "deepseekHarness.openChatEditor"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "deepseekHarness.cliPath": {
          "type": "string",
          "default": "dsh",
          "description": "Path to the `dsh` CLI. Auto-installed on boot unless deepseekHarness.autoInstallDsh is false. Must support `dsh --profile acp` (ACP stdio server)."
        },
        "deepseekHarness.autoInstallDsh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically `npm install -g @deepseek-ai/dsh` on boot when no runnable dsh CLI is found (needs Node.js >=24)."
        },
        "deepseekHarness.profile": {
          "type": "string",
          "default": "acp",
          "description": "DSH profile to spawn for ACP. Default `acp`."
        },
        "deepseekHarness.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "Default working directory for new DSH sessions. Empty = current workspace folder."
        },
        "deepseekHarness.opencodeDbPath": {
          "type": "string",
          "default": "",
          "description": "Override path to opencode.db. Empty = auto-detect (%USERPROFILE%/.local/share/opencode/opencode.db, $XDG_DATA_HOME, $OPENCODE_DB)."
        },
        "deepseekHarness.provider": {
          "type": "string",
          "default": "deepseek-official",
          "description": "DSH model provider route (Harness-style model setup)."
        },
        "deepseekHarness.model": {
          "type": "string",
          "default": "deepseek-v4",
          "description": "DSH model id (Harness-style model setup). Click the model pill in chat or run DSH: Setup Model."
        },
        "deepseekHarness.permissionPreset": {
          "type": "string",
          "enum": ["workspace-write", "danger-full-access"],
          "default": "workspace-write",
          "description": "Harness permission preset: workspace-write (ask) or danger-full-access (never ask)."
        },
        "deepseekHarness.reasoningEffort": {
          "type": "string",
          "default": "",
          "description": "Reasoning effort for new sessions (optional: low/medium/high)."
        },
        "deepseekHarness.maxTokens": {
          "type": "string",
          "default": "",
          "description": "Max tokens for new sessions (optional)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo no-linter"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
